# Copy to .env. With every flag false, ClaimShield runs fully locally.

# --- Google Cloud project ---
GOOGLE_CLOUD_PROJECT=your-project-id
GOOGLE_CLOUD_LOCATION=us-central1

# --- Document AI (Form Parser processor) ---
CLAIMSHIELD_USE_DOCAI=false
DOCAI_LOCATION=us
DOCAI_PROCESSOR_ID=

# --- BigQuery ---
CLAIMSHIELD_USE_BIGQUERY=false
BQ_DATASET=claimshield

# --- Vertex AI Search (Discovery Engine data store with the sample policies) ---
CLAIMSHIELD_USE_VERTEX_SEARCH=false
VERTEX_SEARCH_LOCATION=global
VERTEX_SEARCH_DATASTORE_ID=claimshield-policies

# --- Gemini on Vertex AI ---
CLAIMSHIELD_USE_GEMINI=false
GEMINI_MODEL=gemini-2.5-flash

# --- Cloud Storage (uploads + generated reports) ---
CLAIMSHIELD_USE_GCS=false
GCS_BUCKET=

# --- Behaviour ---
CLAIMSHIELD_USE_ADK=true
# Flag unit prices above this multiple of the 90th-percentile benchmark
CLAIMSHIELD_OUTLIER_RATIO=1.3
# Seconds to pause after each trace step so the live trace is readable in local mode (0 = off)
CLAIMSHIELD_DEMO_PACE=0.35
